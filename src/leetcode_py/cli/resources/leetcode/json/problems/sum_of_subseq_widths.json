        "list": [
            {
                "content": "```\nInput: nums = [2,1,3]\nOutput: 6\nExplanation: The subsequences are [1], [2], [3], [2,1], [2,3], [1,3], [2,1,3].\nThe corresponding widths are 0, 0, 0, 1, 1, 2, 2.\nThe sum of these widths is 6.\n```"
            },
            {
                "content": "```\nInput: nums = [2]\nOutput: 0\n```"
