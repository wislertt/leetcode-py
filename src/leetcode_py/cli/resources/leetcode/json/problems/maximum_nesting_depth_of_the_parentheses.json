        "list": [
            {
                "content": "```\nInput: s = \"(1+(2*3)+((8)/4))+1\"\nOutput: 3\nExplanation: Digit 8 is inside of 3 nested parentheses in the string.\n```"
            },
            {
                "content": "```\nInput: s = \"(1)+((2))+(((3)))\"\nOutput: 3\nExplanation: Digit 3 is inside of 3 nested parentheses in the string.\n```"
            },
            {
                "content": "```\nInput: s = \"()(())((()()))\"\nOutput: 3\n```"
            }
        ]
    },
